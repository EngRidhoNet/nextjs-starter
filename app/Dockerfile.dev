# ==============================================================================
# Dockerfile.dev — Winsta AI Frontend (Development with Hot Reload)
# ==============================================================================

FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

# Install dependencies first (for layer caching)
COPY package.json package-lock.json* ./
RUN npm ci

# Source will be mounted as volume at runtime

EXPOSE 3000

CMD ["npm", "run", "dev"]
